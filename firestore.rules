rules_version = '2';

// Reglas de Firestore - Sistema escolar NexCode
// IMPORTANTE: cambia TU_SUPER_UID por el mismo valor de SUPER_UID que tienes en firebase-config.js

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function conSesion() { return request.auth != null; }
    function esSuper() { return conSesion() && request.auth.uid == 'TU_SUPER_UID'; }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function tienePerfil() { return conSesion() && exists(rutaPerfil()); }
    function perfil() { return get(rutaPerfil()).data; }
    function colegioActivo(cid) { return get(/databases/$(database)/documents/colegios/$(cid)).data.activo == true; }

    // Usuario activo del colegio, con el servicio del colegio activo
    function miembro(cid) {
      return tienePerfil() && perfil().colegioId == cid && perfil().activo == true && colegioActivo(cid);
    }
    function admin(cid)    { return esSuper() || (miembro(cid) && perfil().rol == 'admin'); }
    function personal(cid) { return esSuper() || (miembro(cid) && perfil().rol in ['admin', 'maestro']); }
    function alumno(cid) {
      return miembro(cid) && perfil().rol == 'alumno'
        && get(/databases/$(database)/documents/colegios/$(cid)).data.portalAlumnos == true;
    }
    function miAlumnoId() { return perfil().alumnoId; }

    // ---------- Usuarios ----------
    match /usuarios/{uid} {
      allow read: if esSuper()
        || (conSesion() && request.auth.uid == uid)
        || (tienePerfil() && resource.data.colegioId == perfil().colegioId && perfil().rol in ['admin', 'maestro'] && perfil().activo == true);

      // La administración crea cuentas solo de su propio colegio
      allow create: if esSuper()
        || (admin(request.resource.data.colegioId)
            && request.resource.data.rol in ['admin', 'maestro', 'alumno']);

      allow update: if esSuper()
        || (admin(resource.data.colegioId)
            && request.resource.data.colegioId == resource.data.colegioId
            && request.resource.data.rol in ['admin', 'maestro', 'alumno'])
        // Cada quien solo puede actualizar su hora de último acceso
        || (conSesion() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso']));

      allow delete: if esSuper();
    }

    // ---------- Colegios ----------
    match /colegios/{cid} {
      // Cualquier usuario del colegio puede leerlo (aunque esté suspendido, para mostrar el aviso)
      allow read: if esSuper() || (tienePerfil() && perfil().colegioId == cid);
      allow write: if esSuper();

      match /config/{id} {
        allow read: if esSuper() || miembro(cid);
        allow write: if admin(cid);
      }
      match /grados/{id} {
        allow read: if esSuper() || miembro(cid);
        allow write: if admin(cid);
      }
      match /cursos/{id} {
        allow read: if personal(cid);
        allow write: if admin(cid);
      }
      match /alumnos/{id} {
        allow read: if personal(cid) || (alumno(cid) && id == miAlumnoId());
        allow write: if admin(cid);
      }
      match /pagos/{id} {
        allow read, write: if admin(cid);
      }
      match /asistencia/{id} {
        allow read, write: if personal(cid);
      }
      match /tareas/{id} {
        allow read, write: if personal(cid);
      }
      match /examenes/{id} {
        allow read, write: if personal(cid);
      }

      // Copia de la tarea SIN notas: es lo único de las tareas que el alumno puede leer
      match /tareasAlumnos/{id} {
        allow read: if personal(cid) || alumno(cid);
        allow write: if personal(cid);
      }

      // Notas publicadas: un documento por alumno, solo con SUS notas (id = alumnoId)
      match /notasAlumnos/{aid} {
        allow read: if personal(cid) || (alumno(cid) && aid == miAlumnoId());
        allow write: if admin(cid);
      }

      // Entregas en línea: id = tareaId_alumnoId
      match /entregas/{id} {
        allow read: if personal(cid)
          || (alumno(cid) && resource.data.alumnoId == miAlumnoId());

        // El maestro o la administración: escribe la nota (calif)
        allow create, update: if personal(cid);

        // El alumno: solo su propia entrega, sin tocar la nota, y solo si aún no está calificada
        allow create: if alumno(cid)
          && request.resource.data.alumnoId == miAlumnoId()
          && id == request.resource.data.tareaId + '_' + miAlumnoId()
          && !('calif' in request.resource.data)
          && request.resource.data.keys().hasOnly(['tareaId', 'alumnoId', 'gradoId', 'cursoId', 'anio', 'texto', 'enlace', 'archivo', 'enviada', 'tarde', 'uid'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 5000
          && request.resource.data.enlace is string && request.resource.data.enlace.size() <= 1000;

        allow update: if alumno(cid)
          && resource.data.alumnoId == miAlumnoId()
          && request.resource.data.alumnoId == miAlumnoId()
          && request.resource.data.tareaId == resource.data.tareaId
          && (!('calif' in resource.data) || resource.data.calif == null)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['calif'])
          && request.resource.data.keys().hasOnly(['tareaId', 'alumnoId', 'gradoId', 'cursoId', 'anio', 'texto', 'enlace', 'archivo', 'enviada', 'tarde', 'uid', 'calif'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 5000
          && request.resource.data.enlace is string && request.resource.data.enlace.size() <= 1000;

        allow delete: if personal(cid)
          || (alumno(cid) && resource.data.alumnoId == miAlumnoId()
              && (!('calif' in resource.data) || resource.data.calif == null));
      }
    }
  }
}
